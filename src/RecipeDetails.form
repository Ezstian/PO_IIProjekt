<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="RecipeDetails">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="7" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="10">
    <margin top="20" left="20" bottom="20" right="20"/> <constraints> <xy x="20" y="20" width="500" height="600"/>
    </constraints>
    <properties>
      <background color="-1"/>
    </properties>
    <border type="none"/> <children>
      <component id="title" class="javax.swing.JLabel" binding="titleLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Segoe UI" size="24" style="1"/>
          <text value="Tytuł Przepisu"/>
        </properties>
      </component>
      <component id="info" class="javax.swing.JLabel" binding="infoLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Kategoria | Czas"/>
        </properties>
      </component>
      <scrollpane id="scroll1">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="100"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none" title="Składniki"/>
        <children>
          <component id="ing" class="javax.swing.JTextArea" binding="ingredientsArea">
            <properties/>
          </component>
        </children>
      </scrollpane>
      <scrollpane id="scroll2">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="200"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none" title="Instrukcja przygotowania"/>
        <children>
          <component id="ins" class="javax.swing.JTextArea" binding="instructionsArea">
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="btn" class="javax.swing.JButton" binding="closeButton">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Zamknij"/>
        </properties>
      </component>
    </children>
  </grid>
</form>