<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="MyRecipes">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="5" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="25" left="25" bottom="25" right="25"/>
    <constraints>
      <xy x="20" y="20" width="700" height="500"/>
    </constraints>
    <properties>
      <background color="-1"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="title" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="5" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Segoe UI" size="24" style="1"/>
          <foreground color="-13421773"/>
          <text value="Książka Kucharska - Przepisy"/>
        </properties>
      </component>
      <component id="606ab" class="javax.swing.JCheckBox" binding="onlyMineCheckBox">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-1"/>
          <font name="Segoe UI" style="1"/>
          <text value="Tylko moje przepisy"/>
        </properties>
      </component>
      <component id="7dd67" class="javax.swing.JButton" binding="wszystkieButton">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Wszystkie"/>
        </properties>
      </component>
      <component id="bba8a" class="javax.swing.JButton" binding="sniadaniaButton">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Śniadania"/>
        </properties>
      </component>
      <component id="eb063" class="javax.swing.JButton" binding="obiadyButton">
        <constraints>
          <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Obiady"/>
        </properties>
      </component>
      <component id="ab845" class="javax.swing.JButton" binding="deseryButton">
        <constraints>
          <grid row="1" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Desery"/>
        </properties>
      </component>
      <scrollpane id="scroll">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="5" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="514e4" binding="recipeContainer" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="10" left="10" bottom="10" right="10"/>
            <constraints/>
            <properties>
              <background color="-1"/>
            </properties>
            <border type="none"/>
            <children/>
          </grid>
        </children>
      </scrollpane>
      <component id="btnClose" class="javax.swing.JButton" binding="closeButton">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="5" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Powrót do Menu"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
